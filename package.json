    "expo-location": "~58.0.19",
    "expo-status-bar": "~58.0.4",
    "firebase": "^12.19.0",
    "geofire-common": "^6.0.0",
    "leaflet": "^1.9.4",
    "lucide-react-native": "^1.61.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.88.0",
    "react-native-maps": "^1.29.11",
    "react-native-safe-area-context": "~5.10.1",
